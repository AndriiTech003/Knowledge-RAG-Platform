{
  "name": "kb-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --port 4420",
    "build": "ng build --configuration production",
    "test": "ng test --watch=false",
    "lint": "eslint . && node scripts/check-templates.mjs && node scripts/check-i18n.mjs",
    "e2e": "playwright test",
    "api:gen": "ng-openapi-gen --config ng-openapi-gen.json && node scripts/strip-comments.mjs src/app/core/api",
    "serve:dist": "node scripts/serve.mjs",
    "i18n:extract": "ng extract-i18n",
    "i18n:verify": "node scripts/verify-i18n-catalog.mjs",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 ng run kb-web:storybook",
    "storybook:build": "STORYBOOK_DISABLE_TELEMETRY=1 ng run kb-web:build-storybook",
    "storybook:test": "node scripts/storybook-test.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/animations": "^22.2.1",
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/localize": "^22.2.1",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/roboto": "^5.3.0",
    "@material-symbols/font-400": "^0.47.6",
    "@ngrx/signals": "^22.0.1",
    "angular-auth-oidc-client": "^22.0.1",
    "dompurify": "^3.4.16",
    "echarts": "^6.1.0",
    "marked": "^18.0.14",
    "ngx-echarts": "^22.0.0",
    "ngx-extended-pdf-viewer": "^30.0.1",
    "ngx-markdown": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.1",
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@storybook/angular": "^10.6.1",
    "@storybook/test-runner": "^0.26.0",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "jsdom": "^30.0.0",
    "lighthouse": "^13.5.0",
    "ng-openapi-gen": "^1.1.0",
    "prettier": "^3.8.1",
    "puppeteer-core": "^25.12.0",
    "storybook": "^10.6.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  }
}
